{
  "name": "streetverse",
  "version": "1.0.0",
  "private": true,
  "description": "StreetVerse: AI-Powered Hyperlocal Commerce & Service Discovery Platform",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "dev:buyer": "npm --prefix apps/buyer-web run dev",
    "dev:seller": "npm --prefix apps/seller-web run dev",
    "dev:gateway": "npm --prefix services/api-gateway run dev",
    "dev:ai": "uvicorn services.ai-agent-engine.main:app --host 0.0.0.0 --port 8000 --reload",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "tunnel": "powershell -ExecutionPolicy Bypass -File .\\start-tunnel.ps1 -Port 5000",
    "tunnel:ngrok": "ngrok http 5000 --url https://unplowed-nutlike-antitoxic.ngrok-free.dev",
    "tunnel:cloudflared": "cloudflared tunnel --url http://localhost:5000",
    "test": "npx tsx test-cases/run-all-tests.ts"
  },
  "keywords": [
    "hyperlocal-commerce",
    "rag-search",
    "postgis",
    "pgvector",
    "nextjs",
    "express",
    "upi-payments",
    "langgraph"
  ],
  "author": "Sanchit Tangri (Group P76, MIT-WPU)",
  "license": "MIT",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "tsx": "^4.23.13"
  }
}
