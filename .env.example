# ========================================================
# Local Backend Environment Configuration (.env)
# ========================================================

# Server Port
PORT=5000

# Local PostgreSQL Connection String
# If using docker-compose.yml:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trading_db?schema=public"

# CORS Configuration
# Whitelist your local development ports and your Vercel deployment domain
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://your-app.vercel.app"

# ========================================================
# Frontend Environment Configuration (for Vercel & local)
# ========================================================
# In Vercel Project Settings > Environment Variables, set:
# NEXT_PUBLIC_API_URL="https://<your-tunnel-subdomain>.trycloudflare.com"
# or
# VITE_API_URL="https://<your-tunnel-subdomain>.trycloudflare.com"
