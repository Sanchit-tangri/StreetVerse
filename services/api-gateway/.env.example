# ========================================================
# StreetVerse API Gateway Configuration Example
# Copy to .env for local use. Never commit real secrets.
# ========================================================

# Environment mode: development | test | staging | production
NODE_ENV=development
PORT=5000

# Comma-separated exact origins (wildcards like * are rejected; HTTPS required in staging/production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT Authentication (REQUIRED: generate >= 32 random bytes, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=REPLACE_WITH_MIN_32_BYTE_RANDOM_SECRET
JWT_ISSUER=streetverse-api
JWT_BUYER_AUDIENCE=streetverse-buyer
JWT_SELLER_AUDIENCE=streetverse-seller
JWT_ADMIN_AUDIENCE=streetverse-admin
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=8h

# Explicit operational Admin provisioning variables (CLI bootstrap only; never commit real credentials)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_NAME=Verification Admin
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Redis & Internal Microservices
REDIS_URL=redis://localhost:6380
AI_ENGINE_URL=http://localhost:8000

# Dual PostgreSQL URLs (retained until Stage 2 single-database consolidation)
CUSTOMER_DB_URL=postgresql://postgres:postgres@localhost:5433/streetverse_customer_db
MERCHANT_DB_URL=postgresql://postgres:postgres@localhost:5434/streetverse_merchant_db

# Private KYC Document Storage Directory (must sit on a persistent encrypted volume in production; never inside static/public web dirs)
KYC_STORAGE_DIR=./data/kyc-documents

# SMTP Email Settings (Placeholders only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=YOUR_SMTP_USER_EMAIL_HERE
SMTP_PASS=YOUR_SMTP_APP_PASSWORD_HERE
SMTP_FROM="StreetVerse Security" <noreply@example.com>

# MO-B4 Owner Notification Outbox Worker Settings (PostgreSQL-backed)
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_POLL_MS=5000
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_WORKER_LEASE_MS=30000
NOTIFICATION_WORKER_MAX_ATTEMPTS=5
NOTIFICATION_WORKER_BASE_RETRY_MS=2000
NOTIFICATION_WORKER_MAX_RETRY_MS=60000
